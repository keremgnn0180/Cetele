{
  "name": "cetele",
  "version": "1.0.12",
  "description": "Modern ve sade masaüstü Çetele uygulaması",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "vite-build": "vite build",
    "build": "node -e \"try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){};try{fs.rmSync('release',{recursive:true,force:true})}catch(e){};\" && npm run vite-build && electron-builder --publish never",
    "build:release": "node -e \"try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){};try{fs.rmSync('release',{recursive:true,force:true})}catch(e){};\" && npm run vite-build && electron-builder -c.win.signAndEditExecutable=true",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "installer": "node -e \"try{fs.rmSync('release',{recursive:true,force:true})}catch(e){};\" && npm run vite-build && electron-builder --win nsis --publish never",
    "installer:portable": "node -e \"try{fs.rmSync('release',{recursive:true,force:true})}catch(e){};\" && npm run vite-build && electron-builder --win portable --publish never",
    "package": "electron-builder --dir",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.468.0",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "sql.js": "^1.12.0",
    "vite-plugin-static-copy": "^4.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "34.0.2",
    "electron-builder": "24.13.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^2.1.8",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.7",
    "wait-on": "^9.1.0"
  },
  "keywords": [
    "tarla",
    "masraf",
    "takip",
    "electron",
    "react",
    "sqlite"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "build": {
    "appId": "com.cetele.app",
    "productName": "Cetele",
    "executableName": "cetele",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "database.js",
      "src/main/**/*",
      "src/shared/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "assets/icon.ico"
      }
    ],
    "icon": "assets/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "keremgnn0180",
        "repo": "Cetele"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Cetele",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "cetele-setup-${version}.exe"
    }
  }
}
